# Copy this file to .env and paste your own key (never commit .env).
# Get a free key: Google Cloud Console -> new project -> enable "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key.
YOUTUBE_API_KEY=paste-your-key-here

# Optional: a different Sentence-BERT model
# CLIPSAGE_SBERT_MODEL=all-mpnet-base-v2
